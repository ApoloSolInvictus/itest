rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isEducator(userId) {
      return isOwner(userId)
        && (request.auth.token.educator == true || request.auth.token.employer == true);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /documents/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /exams/{examId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /attempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }
      match /assignedExams/{assignmentKey} {
        allow read: if isOwner(userId);
        allow write: if false;

        match /attempts/{attemptId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }
      match /mailingLists/{listId} {
        allow read: if isEducator(userId);
        allow write: if false;
      }
      match /studentResults/{resultId} {
        allow read: if isEducator(userId);
        allow write: if false;
      }
      match /assignments/{assignmentId} {
        allow read: if isEducator(userId);
        allow write: if false;

        match /results/{resultId} {
          allow read: if isEducator(userId);
          allow write: if false;
        }
        match /sessions/{sessionId} {
          allow read, write: if false;
        }
      }
    }

    match /publicExams/{shareId} {
      allow read, write: if false;
    }
  }
}
